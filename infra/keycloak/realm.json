{
  "realm": "kappalake",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginTheme": "keycloak",
  "clients": [
    {
      "clientId": "kappalake-ui",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"]
    },
    {
      "clientId": "kappalake-api",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "secret": "kappalake-api-secret",
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@kappalake.org",
      "firstName": "Demo",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo1234",
          "temporary": false
        }
      ]
    }
  ]
}
