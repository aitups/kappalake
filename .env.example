# ============================================================
# KappaLake environment variables (copy this file to .env and adjust)
# ============================================================

# --- Postgres (metadata) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=metastore

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_URL=http://minio:9000

# --- Trino ---
TRINO_URL=http://trino:8080
TRINO_USER=admin

# --- LLM (Hayai, OpenAI-compatible) ---
LLM_API_URL=http://llm:8080/v1
LLM_MODEL=Qwen3.5-2B-Q4_K_M
LLM_API_KEY=sk-no-key-required

# --- Dagster ---
DAGSTER_POSTGRES_USER=admin
DAGSTER_POSTGRES_PASSWORD=password
DAGSTER_POSTGRES_DB=dagster

# --- Keycloak / OIDC ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=kappalake
AUTH_ENABLED=false
KC_CLIENT_ID=kappalake-ui
KC_REDIRECT_URI=http://localhost:3001/api/auth/callback
KC_ISSUER=http://localhost:8180/realms/kappalake
KC_ISSUER_INTERNAL=http://keycloak:8080/realms/kappalake

# --- Streaming ---
REDPANDA_BOOTSTRAP=redpanda:29092
STREAM_INTERVAL_SECONDS=10
FLUSH_INTERVAL_SECONDS=30

# --- UI ---
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
